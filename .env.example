# Optional LivingOS API integration for the chat interview.
# Mint with:
#   cd /home/gui/livingos-api
#   source /home/gui/livingos/mcp/credentials.env
#   .venv/bin/python -m app.cli.keys mint --name=contract-intel-mvp-codex --schemas=openai --scopes=generic
LIVINGOS_API_KEY=sk-livingos-...
LIVINGOS_API_BASE_URL=http://127.0.0.1:8510/v1
LIVINGOS_API_MODEL=bare-sonnet-codex
LIVINGOS_API_INTERVIEW=1
